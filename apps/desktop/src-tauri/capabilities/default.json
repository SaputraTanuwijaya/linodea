{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main, alert, timer, and confirm windows",
  "windows": ["main", "alert", "timer", "confirm"],
  "permissions": [
    "core:default",
    "notification:default",
    "autostart:default",
    "opener:default",
    "updater:default",
    "process:default"
  ]
}
