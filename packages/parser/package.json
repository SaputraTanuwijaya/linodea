{
  "name": "@linodea/parser",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "npm run build -w @linodea/types",
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "npm run build -w @linodea/types",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@linodea/types": "0.1.0"
  },
  "devDependencies": {
    "typescript": "~5.8.3"
  }
}
